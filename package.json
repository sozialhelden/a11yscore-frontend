{
  "name": "a11yscore-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "echo 'no unit tests yet'",
    "test:e2e": "echo 'no e2e tests yet'",
    "transifex:sync": "env-cmd --use-shell -- txjs-cli push app/ --token=\\$TRANSIFEX_TOKEN --secret=\\$TRANSIFEX_SECRET",
    "postinstall": "husky"
  },
  "dependencies": {
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "@sozialhelden/core": "2.3.0",
    "@sozialhelden/ui": "1.9.5",
    "@transifex/native": "7.1.6",
    "@transifex/react": "7.1.6",
    "dompurify": "3.4.13",
    "hashids": "2.3.0",
    "isbot": "5.2.0",
    "lucide-react": "0.577.0",
    "luxon": "3.7.2",
    "marked": "16.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@react-router/dev": "7.18.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "@transifex/cli": "7.1.6",
    "@types/luxon": "3.7.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "env-cmd": "11.0.0",
    "husky": "9.1.7",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4"
  }
}
